# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
APP_PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://tamer:changeme@db:5432/tamer_studio
POSTGRES_DB=tamer_studio
POSTGRES_USER=tamer
POSTGRES_PASSWORD=changeme
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Auth
BETTER_AUTH_SECRET=changeme
AUTH_SECRET=changeme
BETTER_AUTH_URL=https://your-domain.com
AUTH_URL=https://your-domain.com

# Admin Bootstrap (Founder)
# SHA-256 hash of the admin master key
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('your-key').digest('hex'))"
ADMIN_MASTER_KEY_HASH=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=tamer-studio
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tamerstudio.com

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stripe

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# Security
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
