# ======================================================
# Rate Limiting (Upstash Redis)
# ======================================================

UPSTASH_REDIS_REST_URL="https://[your-upstash-url].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[your-upstash-token]"

# ======================================================
# Redis (for WebSocket adapters & caching)
# ======================================================

REDIS_URL="redis://localhost:6379"

# ======================================================
# Application
# ======================================================

NODE_ENV=development

NEXT_PUBLIC_APP_NAME="Tamer Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ======================================================
# Database
# ======================================================

DATABASE_URL="postgresql://username:password@localhost:5432/tamer_studio"

# ======================================================
# Authentication
# ======================================================

BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_SECRET="replace-with-a-secure-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ======================================================
# Object Storage (Cloudflare R2)
# ======================================================

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ======================================================
# Storage
# ======================================================

STORAGE_PROVIDER="local"
ASSET_STORAGE_DIR="/tmp/tamer-assets"

# ======================================================
# AI Gateway
# ======================================================

AI_GATEWAY_PROVIDER="kilo"

KILO_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# ======================================================
# Payment (iPaymu)
# ======================================================

IPAYMU_API_KEY=""
IPAYMU_SECRET_KEY=""
IPAYMU_MERCHANT_ID=""
IPAYMU_SANDBOX=""
IPAYMU_VA=""
IPAYMU_ENVIRONMENT="sandbox"

# ======================================================
# Payment (Stripe)
# ======================================================

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ======================================================
# Manual Bank Transfer
# ======================================================

TRANSFER_BANK_NAME=""
TRANSFER_ACCOUNT_NUMBER=""
TRANSFER_ACCOUNT_HOLDER=""
TRANSFER_INSTRUCTIONS=""

# ======================================================
# Email / Encryption
# ======================================================

EMAIL_ENCRYPTION_KEY=""
NOTIFICATION_DEFAULT_FROM_EMAIL="noreply@tamerstudio.com"
NOTIFICATION_DEFAULT_FROM_NAME="Tamer Studio"
NOTIFICATION_EMAIL_PROVIDER=""

# ======================================================
# SMTP
# ======================================================

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ======================================================
# Queue / Background Jobs
# ======================================================

TRIGGER_SECRET_KEY=""

# ======================================================
# Monitoring
# ======================================================

SENTRY_DSN=""

# ======================================================
# Feature Flags
# ======================================================

FEATURE_AFFILIATE=true
FEATURE_DRAMA=true
FEATURE_STORY=false
FEATURE_TALENT=false
FEATURE_ADMIN=true

# ======================================================
# Admin
# ======================================================

# SHA-256 hash of the admin master key
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('your-key').digest('hex'))"
ADMIN_MASTER_KEY_HASH=""

# Admin bootstrap credentials (for scripts/create-admin.ts only — remove after use)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ======================================================
# Production / Docker
# ======================================================

# Storage
STORAGE_PROVIDER="local"
ASSET_STORAGE_DIR="/tmp/tamer-assets"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Monitoring
ENABLE_MONITORING="true"
LOG_LEVEL="info"
